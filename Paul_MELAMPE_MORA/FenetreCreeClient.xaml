<Window x:Class="Paul_MELAMPE_MORA.FenetreCreeClient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Créer un nouveau client" Height="520" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Background="#E8E2D9" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nouveau Client" FontSize="26" FontFamily="Century" FontWeight="Bold" Foreground="#2A2421" Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <Border Grid.Row="1" Background="#F6F4F0" CornerRadius="8" Padding="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.1" Direction="270" Color="#2A2421" />
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Nom * :" FontSize="13" Foreground="#7A6D61" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="txtNouveauNom" Padding="8" Background="#FFFFFF" BorderBrush="#D5CFC4" BorderThickness="1" FontSize="14" Foreground="#2A2421" Margin="0,0,0,15"/>

                <TextBlock Text="Prénom :" FontSize="13" Foreground="#7A6D61" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="txtNouveauPrenom" Padding="8" Background="#FFFFFF" BorderBrush="#D5CFC4" BorderThickness="1" FontSize="14" Foreground="#2A2421" Margin="0,0,0,15"/>

                <TextBlock Text="Téléphone * :" FontSize="13" Foreground="#7A6D61" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="txtNouveauTel" Padding="8" Background="#FFFFFF" BorderBrush="#D5CFC4" BorderThickness="1" FontSize="14" Foreground="#2A2421" Margin="0,0,0,15"/>

                <TextBlock Text="Email :" FontSize="13" Foreground="#7A6D61" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="txtNouveauMail" Padding="8" Background="#FFFFFF" BorderBrush="#D5CFC4" BorderThickness="1" FontSize="14" Foreground="#2A2421"/>

            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,25,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnAnnuler" Grid.Column="0" Content="ANNULER" Background="Transparent" Foreground="#7A6D61" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="13" Margin="0,0,15,0" Click="BtnAnnuler_Click"/>

            <Button x:Name="btnCreer" Grid.Column="1" Content="ENREGISTRER LE CLIENT" Background="#C29227" Foreground="White" BorderThickness="0" Padding="20,12" Cursor="Hand" FontWeight="Bold" FontSize="13" Click="BtnCreer_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>