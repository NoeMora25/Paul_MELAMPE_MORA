<Window x:Class="Paul_MELAMPE_MORA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Paul_MELAMPE_MORA"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="#FF656565" MinWidth="340" MinHeight="450" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="Bandeau" Height="50" Background="Black">

            <Label HorizontalAlignment="Right" Content="&#x23FB;" VerticalAlignment="Center" Foreground="#FF927F00" Width="41" Height="42" FontSize="28" FontFamily="Lucida Fax" Margin="0,0,10,0" RenderTransformOrigin="0.768,0.571"/>
            <Image Source="/img/LogoPaul.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Width="50" Margin="20,0,0,0"/>
        </Grid>

        <ContentControl Grid.Row="1" x:Name="MainContent" Margin="10" />

    </Grid>
</Window>