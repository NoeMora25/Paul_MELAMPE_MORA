<Window x:Class="Paul_MELAMPE_MORA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Paul_MELAMPE_MORA"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="#FF656565">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="Bandeau" Height="50" Background="Black">
            <Label HorizontalAlignment="Left" Content="Paul" VerticalAlignment="Center" Foreground="#FF927F00" Width="68" Height="42" FontSize="28" FontFamily="Lucida Fax" Margin="10,0,0,0" RenderTransformOrigin="0.768,0.571"/>

            <Label HorizontalAlignment="Right" Content="&#x23FB;" VerticalAlignment="Center" Foreground="#FF927F00" Width="41" Height="42" FontSize="28" FontFamily="Lucida Fax" Margin="0,0,10,0" RenderTransformOrigin="0.768,0.571"/>
        </Grid>

        <ContentControl Grid.Row="1" x:Name="MainContent" Margin="10" />

    </Grid>
</Window>