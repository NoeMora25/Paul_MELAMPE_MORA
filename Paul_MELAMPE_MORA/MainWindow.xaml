<Window x:Class="Paul_MELAMPE_MORA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Paul_MELAMPE_MORA"
        mc:Ignorable="d"
        Title="La Boulangerie de Paul" Height="450" Width="800" Background="#FF222222" 
        MinWidth="340" MinHeight="450" ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen" WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BANDEAU SUPERIEUR : Hauteur augmentée de 60 à 90 -->
        <Grid Grid.Row="0" x:Name="Bandeau" Height="90" Background="#1A1A1A">

            <Grid.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.5" Direction="270" />
            </Grid.Effect>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo : Hauteur augmentée de 40 à 70 et marge gauche augmentée -->
            <Image Grid.Column="0" Source="/img/LogoPaul.png" Stretch="Uniform" Height="70" Margin="30,0,0,0" VerticalAlignment="Center"/>

            <!-- Bouton Quitter : FontSize augmentée de 28 à 40 -->
            <Button x:Name="ButDeconnecter" Grid.Column="2" Content="&#x23FB;" Foreground="#FF927F00" Background="Transparent" BorderThickness="0" FontSize="40" FontFamily="Lucida Fax" VerticalAlignment="Center" Margin="0,0,30,0" Cursor="Hand" Click="ButDeconnecter_Click"/>
        </Grid>

        <ContentControl Grid.Row="1" x:Name="MainContent" Margin="0" />

    </Grid>
</Window>