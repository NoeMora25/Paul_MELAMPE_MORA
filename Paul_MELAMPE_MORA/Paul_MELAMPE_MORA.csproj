<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>img\LogoPaul.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="img\img_paul_illustration.png" />
    <None Remove="img\LogoPaul.ico" />
    <None Remove="img\LogoPaul.jpg" />
    <None Remove="img\LogoPaul.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="img\LogoPaul.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="img\img_paul_illustration.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="img\LogoPaul.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
