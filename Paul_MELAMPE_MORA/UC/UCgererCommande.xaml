<UserControl x:Class="Paul_MELAMPE_MORA.UC.UCgererCommande"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul_MELAMPE_MORA.UC"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="#FF2F2F2F">
    <StackPanel>
        <Label Content="Gérer les commandes" Margin="23,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="28" Foreground="White" />
        

        <Grid Margin="0,15,0,0">
            <Border Grid.Column="0" Background="#D6D6D6" CornerRadius="10" Padding="15" Margin="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="icProduits" ItemsSource="{Binding LesCommandes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#ABABAB" CornerRadius="8" Padding="15,10" Margin="0,0,0,15">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="400">

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Client.Nom}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Foreground="#222222"/>
                                                <TextBlock Text="{Binding Categorie_evenement.Categorie_evenement_nom}" FontSize="16" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="Date de création : " FontSize="14" Foreground="#444444" FontStyle="Italic"/>
                                                <TextBlock Text="{Binding Date_creation}" FontSize="14" Foreground="#444444" FontStyle="Italic"/>
                                                <TextBlock Text=" - Date de retrait : " FontSize="14" Foreground="#444444"/>
                                                <TextBlock Text="{Binding Date_retrait}" FontSize="14" FontWeight="Bold" Foreground="#1E90FF"/>
                                            </StackPanel>


                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="Est prête : " FontSize="14" Foreground="#444444" FontStyle="Italic"/>
                                                <TextBlock Text="{Binding Est_prete}" FontSize="14" Foreground="#444444" FontStyle="Italic"/>
                                                <TextBlock Text=" - A été récupérée : " FontSize="14" Foreground="#444444"/>
                                                <TextBlock Text="{Binding Est_recuperee}" FontSize="14" FontWeight="Bold" Foreground="#1E90FF"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="Acompte : " FontSize="14" Foreground="#444444" FontStyle="Italic"/>
                                                <TextBlock Text="{Binding Acompte}" FontSize="14" Foreground="#444444" FontStyle="Italic"/>
                                                <TextBlock Text=" - Total : " FontSize="14" Foreground="#444444"/>
                                                <TextBlock Text="{Binding Total}" FontSize="14" FontWeight="Bold" Foreground="#1E90FF"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="Date de l'évènement :" FontSize="14" Foreground="#444444" FontStyle="Italic"/>
                                                <TextBlock Text="{Binding Date_evenement}" FontSize="14" Foreground="#444444" FontStyle="Italic"/>
                                                <TextBlock Text=" - Nombre de peronnes : " FontSize="14" Foreground="#444444"/>
                                                <TextBlock Text="{Binding Nb_personne}" FontSize="14" FontWeight="Bold" Foreground="#1E90FF"/>
                                            </StackPanel>

                                        </StackPanel>


                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </StackPanel>

</UserControl>
