<UserControl x:Class="Paul_MELAMPE_MORA.UC.UClogin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul_MELAMPE_MORA.UC"
             mc:Ignorable="d" Background="#FF2F2F2F" BorderBrush="Black" Foreground="White" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

                <TextBlock Text="Boulangerie Paul" 
                           FontSize="30" 
                           Foreground="White" 
                           FontFamily="Century" 
                           TextAlignment="Center" 
                           Margin="0,0,0,40" />

                <TextBlock Text="Login" 
                           FontSize="18" 
                           Foreground="#FF927F00" 
                           Margin="0,0,0,5" />

                <Border Background="#FFCECECE" CornerRadius="5" Height="35" Margin="0,0,0,20">
                    <TextBox x:Name="TxtLogin" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             VerticalContentAlignment="Center" 
                             Padding="10,0" 
                             FontSize="16" 
                             Foreground="Black" 
                             AutomationProperties.HelpText="Login" />
                </Border>

                <TextBlock Text="Mot de passe" 
                           FontSize="18" 
                           Foreground="#FF927F00" 
                           Margin="0,0,0,5" />

                <Border Background="#FFD0D0D0" CornerRadius="5" Height="35" Margin="0,0,0,10">
                    <PasswordBox x:Name="TxtMDP" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             VerticalContentAlignment="Center" 
                             Padding="10,0" 
                             FontSize="16" 
                             Foreground="Black" 
                             AutomationProperties.HelpText="Mot de passe" />
                </Border>

                <Label x:Name="MsgErreur" 
                       Content="" 
                       Foreground="#FFD00000" 
                       FontSize="14" 
                       HorizontalAlignment="Center" 
                       MinHeight="25" 
                       Margin="0,0,0,15" />

                <Button x:Name="ButConnecter" 
                        Click="ButConnecter_Click" 
                        Height="45" 
                        Width="200"
                        Background="Black" 
                        Foreground="#FF927F00" 
                        BorderBrush="#FF927F00" 
                        BorderThickness="1" 
                        FontSize="16" 
                        Cursor="Hand"
                        HorizontalAlignment="Center" IsDefault="True">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="Se connecter" VerticalAlignment="Center"/>
                </Button>

            </StackPanel>
        </Grid>

        <Border Grid.Column="1" CornerRadius="15,0,0,15" Margin="0,0,0,0">
            <Border.Background>
                <ImageBrush ImageSource="/img/img_paul_illustration.png" Stretch="UniformToFill"/>
            </Border.Background>
        </Border>

    </Grid>

</UserControl>