<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul_MELAMPE_MORA.UC"
             xmlns:materialDesignMahApps="http://materialdesigninxaml.net/winfx/xaml/themes" x:Class="Paul_MELAMPE_MORA.UC.UCproduit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <ComboBox x:Name="ComboAllergenes" Width="200" Margin="20,70,0,0" HorizontalAlignment="Left">
            <ComboBoxItem>
                <CheckBox Content="Sans Gluten (Céréales)"/>
            </ComboBoxItem>
            <ComboBoxItem>
                <CheckBox Content="Sans Œufs"/>
            </ComboBoxItem>
            <ComboBoxItem>
                <CheckBox Content="Sans Lactose (Lait)"/>
            </ComboBoxItem>
            <ComboBoxItem>
                <CheckBox Content="Sans Fruits à coque"/>
            </ComboBoxItem>
            <ComboBoxItem>
                <CheckBox Content="Sans Soja"/>
            </ComboBoxItem>
        </ComboBox>
        
        <DataGrid
    x:Name="dgProduits"
    Width="300"
    Height="330"
    HorizontalAlignment="Center"
    AutoGenerateColumns="False"
    IsReadOnly="True"
    ItemsSource="{Binding}" VerticalAlignment="Center">
            <DataGrid.Columns>
                <DataGridTextColumn
            Width="*"
            Binding="{Binding NomProduit , ValidatesOnExceptions=True}"
            Header="Nom" />
                <DataGridTextColumn
            Width="*"
            Binding="{Binding Allergene, ValidatesOnExceptions=True}"
            Header="Allergene" />
            </DataGrid.Columns>
        </DataGrid>

    </StackPanel>
</UserControl>
