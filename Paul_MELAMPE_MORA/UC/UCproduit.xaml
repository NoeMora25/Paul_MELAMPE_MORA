<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul_MELAMPE_MORA.UC"
             xmlns:materialDesignMahApps="http://materialdesigninxaml.net/winfx/xaml/themes" 
             x:Class="Paul_MELAMPE_MORA.UC.UCproduit"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,20,20,15">

            <TextBlock Text="Catalogue des Produits" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#333333" 
                       Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal">

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Filtrer par allergènes :" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ComboAllergenes" Width="220" Padding="5">
                        <ComboBoxItem>
                            <CheckBox x:Name="chkAleGluten" Content="Sans Gluten (Céréales)" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox x:Name="chkAleOeuf" Content="Sans Œufs" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox x:Name="chkAleLactose" Content="Sans Lactose (Lait)" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox x:Name="chkAleFruitsACoque" Content="Sans Fruits à coque" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox x:Name="chkAleSoja" Content="Sans Soja" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox x:Name="chkAleSesame" Content="Sans Graines de sésame" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox x:Name="chkAleSulfite" Content="Sans Sulfites" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Filtrer par catégories :" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ComboCategories" Width="200" Padding="5">
                        <ComboBoxItem>
                            <CheckBox x:Name="chkCatGateaux" Content="Gâteaux" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox x:Name="chkCatViennoiseries" Content="Viennoiseries" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox x:Name="chkCatPains" Content="Pains" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>

            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="#D6D6D6" CornerRadius="10" Margin="5,20,5,10" Padding="15" MinHeight="300">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <ItemsControl x:Name="icProduits" ItemsSource="{Binding LesProduits}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Background="#ABABAB" CornerRadius="8" Padding="15,10" Margin="0,0,0,15">
                                <Grid>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="250">

                                        <TextBlock Text="{Binding Recette.Recette_nom}" 
                                                   FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Foreground="#222222"/>

                                        <TextBlock Text="{Binding Recette.Categorie.Categorie_nom}" 
                                                   FontSize="14" Foreground="#444444" FontStyle="Italic" Margin="0,5,0,0"/>

                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                                        <Button Content="-" Width="25" Height="25" Background="White" BorderThickness="0" 
                                                Click="BtnMoins_Click" Cursor="Hand"/>

                                        <TextBlock Text="0" Width="30" TextAlignment="Center" VerticalAlignment="Center" 
                                                   Margin="5,0" FontSize="16" FontWeight="Bold"/>

                                        <Button Content="+" Width="25" Height="25" Background="White" BorderThickness="0" 
                                                Click="BtnPlus_Click" Cursor="Hand" Margin="0,0,15,0"/>

                                        <Button Content="Ajouter" Background="#4CAF50" Foreground="White" BorderThickness="0" 
                                                Padding="10,5" Click="BtnAjouter_Click" Cursor="Hand" FontWeight="SemiBold"/>

                                    </StackPanel>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>