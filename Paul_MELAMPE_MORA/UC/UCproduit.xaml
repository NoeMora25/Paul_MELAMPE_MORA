<UserControl x:Class="Paul_MELAMPE_MORA.UC.UCproduit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul_MELAMPE_MORA.UC"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#E8E2D9" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="30,20,30,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Catalogue des Produits" FontSize="28" FontFamily="Century" Foreground="#2A2421" FontWeight="Bold" Margin="0,0,0,15"/>
                <StackPanel Orientation="Horizontal">

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Filtrer par allergènes :" FontSize="13" Foreground="#7A6D61" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ComboAllergenes" Width="220" Padding="6" Background="#F6F4F0" BorderBrush="#D5CFC4">
                            <ComboBoxItem>
                                <CheckBox x:Name="chkAleGluten" Content="Sans Gluten (Céréales)" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <CheckBox x:Name="chkAleOeuf" Content="Sans Œufs" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <CheckBox x:Name="chkAleLactose" Content="Sans Lactose (Lait)" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <CheckBox x:Name="chkAleFruitsACoque" Content="Sans Fruits à coque" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <CheckBox x:Name="chkAleSoja" Content="Sans Soja" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <CheckBox x:Name="chkAleSesame" Content="Sans Graines de sésame" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <CheckBox x:Name="chkAleSulfite" Content="Sans Sulfites" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Filtrer par catégories :" FontSize="13" Foreground="#7A6D61" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ComboCategories" Width="200" Padding="6" Background="#F6F4F0" BorderBrush="#D5CFC4">
                            <ComboBoxItem>
                                <CheckBox x:Name="chkCatGateaux" Content="Gâteaux" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <CheckBox x:Name="chkCatViennoiseries" Content="Viennoiseries" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <CheckBox x:Name="chkCatPains" Content="Pains" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Recherche par nom :" FontSize="13" Foreground="#7A6D61" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtBoxProduit" Width="200" Padding="6" TextChanged="Filtre_Modifie" Background="#F6F4F0" BorderBrush="#D5CFC4" BorderThickness="1" FontSize="14" Foreground="#2A2421"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>


 

            <Button Grid.Column="1" VerticalAlignment="Bottom" Height="45" Width="55" Background="#C29227" BorderThickness="0" Click="BtnVoirPanier_Click" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
                <TextBlock Text="🛒" FontSize="20" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="25,0,25,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="5,5,15,5">
                <ItemsControl x:Name="icProduits" ItemsSource="{Binding LesProduits}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,15">
                                <Border Background="#F6F4F0" CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.1" Direction="270" Color="#2A2421" />
                                    </Border.Effect>
                                </Border>

                                <Border Background="#F6F4F0" BorderBrush="#D5CFC4" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="400">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Recette.Recette_nom}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Foreground="#2A2421"/>
                                                <TextBlock Text="{Binding Nb_parts, StringFormat=' ({0} parts)'}" FontSize="15" Foreground="#A99F93" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding Recette.Categorie.Categorie_nom}" FontSize="14" Foreground="#7A6D61" FontStyle="Italic"/>
                                                <TextBlock Text=" - " FontSize="14" Foreground="#7A6D61"/>
                                                <TextBlock Text="{Binding Prix, StringFormat='{}{0}€'}" FontSize="16" FontWeight="ExtraBold" Foreground="#B88E2F"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="-" Width="28" Height="28" Background="#E8E2D9" Foreground="#3E3631" FontWeight="Bold" BorderThickness="0" Click="BtnMoins_Click" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <TextBlock x:Name="txtQuantiteSelectionnee" Text="0" Width="30" TextAlignment="Center" VerticalAlignment="Center" Margin="5,0" FontSize="16" FontWeight="Bold" Foreground="#2A2421"/>

                                            <Button Content="+" Width="28" Height="28" Background="#E8E2D9" Foreground="#3E3631" FontWeight="Bold" BorderThickness="0" Click="BtnPlus_Click" Cursor="Hand" Margin="0,0,15,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <Button Click="BtnAjouter_Click" Cursor="Hand" Height="34" Width="85" Background="#C29227" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="Bold">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                                <TextBlock Text="AJOUTER" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid x:Name="VoletPanier" Grid.Column="1" Width="300" Margin="10,5,0,15" Visibility="Collapsed">
                <Border Background="#F6F4F0" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.15" Direction="270" Color="#2A2421" />
                    </Border.Effect>
                </Border>
                <Border Background="#F6F4F0" BorderBrush="#D5CFC4" BorderThickness="1" CornerRadius="8" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Panier actuel" FontSize="20" FontFamily="Century" FontWeight="Bold" Foreground="#2A2421" Margin="0,0,0,15" TextAlignment="Center"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LePanier}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E8E2D9" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding LeProduit.Recette.Recette_nom}" FontSize="14" FontWeight="SemiBold" Foreground="#3E3631" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding LeProduit.Nb_parts, StringFormat='{}{0} parts'}" FontSize="12" Foreground="#A99F93"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Quantite, StringFormat='x {0}'}" FontSize="15" FontWeight="Bold" Foreground="#B88E2F" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>