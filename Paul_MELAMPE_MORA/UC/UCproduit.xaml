<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul_MELAMPE_MORA.UC"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             x:Class="Paul_MELAMPE_MORA.UC.UCproduit"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="900"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,20,20,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Catalogue des Produits" FontSize="24" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,15"/>
                <StackPanel Orientation="Horizontal">

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Filtrer par allergènes :" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ComboAllergenes" Width="220" Padding="5">
                            <ComboBoxItem>
                                <CheckBox x:Name="chkAleGluten" Content="Sans Gluten (Céréales)" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <CheckBox x:Name="chkAleOeuf" Content="Sans Œufs" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <CheckBox x:Name="chkAleLactose" Content="Sans Lactose (Lait)" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <CheckBox x:Name="chkAleFruitsACoque" Content="Sans Fruits à coque" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <CheckBox x:Name="chkAleSoja" Content="Sans Soja" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <CheckBox x:Name="chkAleSesame" Content="Sans Graines de sésame" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <CheckBox x:Name="chkAleSulfite" Content="Sans Sulfites" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Filtrer par catégories :" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ComboCategories" Width="200" Padding="5">
                            <ComboBoxItem>
                                <CheckBox x:Name="chkCatGateaux" Content="Gâteaux" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <CheckBox x:Name="chkCatViennoiseries" Content="Viennoiseries" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <CheckBox x:Name="chkCatPains" Content="Pains" Checked="Filtre_Modifie" Unchecked="Filtre_Modifie"/>
                            </ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Recherche par nom :" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtBoxProduit" Width="200" Padding="5" TextChanged="Filtre_Modifie"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" VerticalAlignment="Bottom" Height="50" Width="60" Background="Black" BorderThickness="0" Click="BtnVoirPanier_Click" Cursor="Hand">
                <TextBlock Text="🛒" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF927F00"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="5,0,5,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#D6D6D6" CornerRadius="10" Padding="15" Margin="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="icProduits" ItemsSource="{Binding LesProduits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#ABABAB" CornerRadius="8" Padding="15,10" Margin="0,0,0,15">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="400">

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Recette.Recette_nom}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Foreground="#222222"/>
                                                <TextBlock Text="{Binding Nb_parts, StringFormat=' ({0} parts)'}" FontSize="16" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding Recette.Categorie.Categorie_nom}" FontSize="14" Foreground="#444444" FontStyle="Italic"/>
                                                <TextBlock Text=" - " FontSize="14" Foreground="#444444"/>
                                                <TextBlock Text="{Binding Prix, StringFormat='{}{0}€'}" FontSize="14" FontWeight="Bold" Foreground="#1E90FF"/>
                                            </StackPanel>

                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="-" Width="25" Height="25" Background="White" BorderThickness="0" Click="BtnMoins_Click" Cursor="Hand"/>
                                            <TextBlock Text="0" Width="30" TextAlignment="Center" VerticalAlignment="Center" Margin="5,0" FontSize="16" FontWeight="Bold"/>
                                            <Button Content="+" Width="25" Height="25" Background="White" BorderThickness="0" Click="BtnPlus_Click" Cursor="Hand" Margin="0,0,15,0"/>
                                            <Button Content="Ajouter" Background="#4CAF50" Foreground="White" BorderThickness="0" Padding="10,5" Click="BtnAjouter_Click" Cursor="Hand" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border x:Name="VoletPanier" Grid.Column="1" Width="300" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="10" Margin="10,5,5,5" Padding="15" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Panier actuel" FontSize="18" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,15"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LePanier}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding LeProduit.Recette.Recette_nom}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding LeProduit.Nb_parts, StringFormat='{}{0} parts'}" FontSize="12" Foreground="Gray"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Quantite, StringFormat='x {0}'}" FontSize="16" FontWeight="Bold" Foreground="#1E90FF" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>