<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul_MELAMPE_MORA.UC"
             xmlns:materialDesignMahApps="http://materialdesigninxaml.net/winfx/xaml/themes" x:Class="Paul_MELAMPE_MORA.UC.UCproduit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ComboBox Grid.Row="0" x:Name="ComboAllergenes" Width="200" Margin="0,70,0,20">
            <ComboBoxItem>
                <CheckBox Content="Sans Gluten (Céréales)"/>
            </ComboBoxItem>
            <ComboBoxItem>
                <CheckBox Content="Sans Œufs"/>
            </ComboBoxItem>
            <ComboBoxItem>
                <CheckBox Content="Sans Lactose (Lait)"/>
            </ComboBoxItem>
            <ComboBoxItem>
                <CheckBox Content="Sans Fruits à coque"/>
            </ComboBoxItem>
            <ComboBoxItem>
                <CheckBox Content="Sans Soja"/>
            </ComboBoxItem>
        </ComboBox>
        
        <DataGrid Grid.Row="1" x:Name="dgProduits" AutoGenerateColumns="False" IsReadOnly="True" Margin="20,0,20,20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*" Binding="{Binding Recette.Categorie.Categorie_nom, ValidatesOnExceptions=True}" Header="Categorie" />
                <DataGridTextColumn Width="*" Binding="{Binding Recette.Recette_nom, ValidatesOnExceptions=True}" Header="Nom" />

                <DataGridTextColumn Width="*" Binding="{Binding Recette.Allergenes, ValidatesOnExceptions=True}" Header="Allergene">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="Margin" Value="5" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Width="*" Binding="{Binding Recette.Recette_description, ValidatesOnExceptions=True}" Header="Description">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="Margin" Value="5" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Width="*" Binding="{Binding Est_indisponible, ValidatesOnExceptions=True}" Header="Disponibilité" />
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>