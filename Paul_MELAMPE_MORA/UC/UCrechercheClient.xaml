<UserControl x:Name="ucRechercheClient" x:Class="Paul_MELAMPE_MORA.UC.UCrechercheClient"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul_MELAMPE_MORA.UC"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="850"
             Background="#E8E2D9" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="30,25,30,15">
            <StackPanel>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Rechercher un Client" FontSize="28" FontFamily="Century" FontWeight="Bold" Foreground="#2A2421" VerticalAlignment="Center"/>

                    <Button x:Name="BtnCreeClient" Grid.Column="1" Content="CRÉER UN CLIENT" 
                            Background="#C29227" Foreground="White" BorderThickness="0" Padding="15,10" 
                            Click="BtnCreeClient_Click" Cursor="Hand" FontWeight="Bold" FontSize="13" VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Nom :" FontSize="13" Foreground="#7A6D61" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNom" Width="150" Padding="6" Background="#F6F4F0" BorderBrush="#D5CFC4" BorderThickness="1" FontSize="14" Foreground="#2A2421" TextChanged="Filtre_Modifie"/>
                    </StackPanel>

                    <StackPanel Margin="10,0,15,0">
                        <TextBlock Text="Prénom :" FontSize="13" Foreground="#7A6D61" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtPrenom" Width="150" Padding="6" Background="#F6F4F0" BorderBrush="#D5CFC4" BorderThickness="1" FontSize="14" Foreground="#2A2421" TextChanged="Filtre_Modifie"/>
                    </StackPanel>

                    <StackPanel Margin="10,0,15,0">
                        <TextBlock Text="Téléphone :" FontSize="13" Foreground="#7A6D61" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtTel" Width="150" Padding="6" Background="#F6F4F0" BorderBrush="#D5CFC4" BorderThickness="1" FontSize="14" Foreground="#2A2421" TextChanged="Filtre_Modifie"/>
                    </StackPanel>

                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Email :" FontSize="13" Foreground="#7A6D61" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtMail" Width="180" Padding="6" Background="#F6F4F0" BorderBrush="#D5CFC4" BorderThickness="1" FontSize="14" Foreground="#2A2421" TextChanged="Filtre_Modifie"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,5,15,20">
            <ItemsControl x:Name="icClients" ItemsSource="{Binding LesClients}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,15,15">

                            <Border Background="#F6F4F0" CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.1" Direction="270" Color="#2A2421" />
                                </Border.Effect>
                            </Border>

                            <Border Background="#F6F4F0" BorderBrush="#D5CFC4" BorderThickness="1" CornerRadius="8" Padding="20,15">
                                <Grid>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Nom}" FontSize="18" FontWeight="Bold" Foreground="#2A2421"/>
                                            <TextBlock Text="{Binding Prenom}" FontSize="18" FontWeight="Bold" Foreground="#2A2421" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="📞 " Foreground="#A99F93" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Telephone}" FontSize="14" Foreground="#7A6D61" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="   ✉️ " Foreground="#A99F93" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Mail}" FontSize="14" Foreground="#7A6D61" FontStyle="Italic" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button x:Name="btnSelectionner" Content="SÉLECTIONNER" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="#C29227" Foreground="White" BorderThickness="0" Padding="15,10" 
                                        Click="BtnSelectionner_Click" Cursor="Hand" FontWeight="Bold" FontSize="13" 
                                        Visibility="{Binding VisibiliteBouton, ElementName=ucRechercheClient}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button x:Name="btnCommande" Content="VOIR COMMANDES" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="#3E3631" Foreground="White" BorderThickness="0" Padding="15,10" 
                                        Click="BtnVoirCommandes_Click" Cursor="Hand" FontWeight="Bold" FontSize="13" 
                                        Visibility="{Binding VisibiliteBoutonCommande, ElementName=ucRechercheClient}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>