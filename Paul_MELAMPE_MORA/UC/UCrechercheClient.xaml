<UserControl x:Class="Paul_MELAMPE_MORA.UC.UCrechercheClient"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul_MELAMPE_MORA.UC"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,20,20,15">
            <StackPanel>
                <TextBlock Text="Catalogue des Clients" FontSize="24" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,15"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Recherche par nom :" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNom" Width="160" Padding="5" TextChanged="Filtre_Modifie"/>
                    </StackPanel>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Recherche par prénom :" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtPrenom" Width="160" Padding="5" TextChanged="Filtre_Modifie"/>
                    </StackPanel>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Recherche par tel :" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtTel" Width="160" Padding="5" TextChanged="Filtre_Modifie"/>
                    </StackPanel>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Recherche par mail :" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtMail" Width="160" Padding="5" TextChanged="Filtre_Modifie"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#D6D6D6" CornerRadius="10" Padding="15" Margin="20,5,20,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icClients" ItemsSource="{Binding LesClients}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#ABABAB" CornerRadius="8" Padding="15,10" Margin="0,0,0,15">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Nom}" FontSize="18" FontWeight="Bold" Foreground="#222222"/>
                                            <TextBlock Text="{Binding Prenom}" FontSize="18" FontWeight="Bold" Foreground="#222222" Margin="5,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding Telephone}" FontSize="14" Foreground="#444444"/>
                                            <TextBlock Text=" - " FontSize="14" Foreground="#444444"/>
                                            <TextBlock Text="{Binding Mail}" FontSize="14" Foreground="#444444" FontStyle="Italic"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Content="Sélectionner" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="#4CAF50" Foreground="White" BorderThickness="0" Padding="15,8" 
                                            Click="BtnSelectionner_Click" Cursor="Hand" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>